# Optional runtime settings for Project Angelina
# Copy to .env for local notes, or set these in your shell before running scripts.

# Dashboard defaults to localhost for privacy.
ANGELINA_DASHBOARD_HOST=127.0.0.1
ANGELINA_DASHBOARD_PORT=5001
ANGELINA_DASHBOARD_ENABLED=true

# Leave empty to run without ESP32 hardware.
# Windows example: COM3
# macOS example: /dev/cu.usbserial-0001
# Linux example: /dev/ttyUSB0
ANGELINA_ESP32_PORT=
ANGELINA_ESP32_BAUD=115200
ANGELINA_SERIAL_ENABLED=false

ANGELINA_ALERT_HOLD_S=3.0
ANGELINA_COOLDOWN_S=10.0
ANGELINA_WINDOW_SIZE=30
